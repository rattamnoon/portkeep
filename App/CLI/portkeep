#!/bin/zsh
# portkeep: Portkeep from the terminal. Ships inside Portkeep.app (Contents/Resources/bin) and is
# linked onto PATH by Settings › General › Install Command Line Tool….
#
# Changes go to the app as portkeep:// URLs through `open -g`, which launches Portkeep if needed and
# leaves it in the background. `list` and `status` read status.json, which the app keeps current.
# Only macOS built-ins: zsh, open and osascript (JavaScript for JSON).

emulate -L zsh
setopt err_return no_unset pipe_fail

data_dir=${PORTKEEP_DATA_DIR:-$HOME/Library/Application Support/Portkeep}
status_file=$data_dir/status.json
me=${0:t}

usage() {
  cat <<EOF
Usage: $me <command> [name]

  list                    every tunnel: name, group, port and status
  status <name>           one tunnel's status; exits 0 when connected
  start|stop|toggle <name>
  start-group|stop-group <group>
  start-all|stop-all
  open                    open Portkeep's Settings

Names and groups match ignoring case; a tunnel's id works too.
EOF
}

# Reads status.json. $1 = list | status | names | groups, $2 = what to match (for status, names, groups).
# list/status print tab-separated rows: name, group, port, state, detail.
read_status() {
  osascript -l JavaScript - "$status_file" "$@" <<'JS'
function run(argv) {
  var path = argv[0], mode = argv[1], wanted = (argv[2] || "").toLowerCase();
  var text = $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, null);
  if (text.isNil()) return "missing";
  var data = JSON.parse(text.js);
  ObjC.import("AppKit");
  // A file left behind by a crash still says running; the pid says otherwise.
  var alive = data.running && !$.NSRunningApplication.runningApplicationWithProcessIdentifier(data.pid).isNil();
  var rows = [];
  data.tunnels.forEach(function (t) {
    var byName = t.name.toLowerCase() === wanted || t.id.toLowerCase() === wanted;
    if (mode === "names" && byName) rows.push(t.name);
    if (mode === "groups" && t.group.toLowerCase() === wanted) rows.push(t.name);
    if (mode === "list" || (mode === "status" && byName)) {
      var state = alive ? t.state : "off";
      var detail = alive ? t.status : "Portkeep isn't running";
      if (alive && t.connectedSince) {
        var since = new Date(t.connectedSince);
        detail = "since " + since.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      }
      rows.push([t.name, t.group, String(t.port), state, detail].join("\t"));
    }
  });
  return rows.join("\n");
}
JS
}

# Prints rows from read_status as aligned columns, with a header.
print_table() {
  local -a rows=("${(@f)1}")
  local name=4 group=5 row
  for row in $rows; do
    local -a f=("${(@ps:\t:)row}")
    (( ${#f[1]} > name )) && name=${#f[1]}
    (( ${#f[2]} > group )) && group=${#f[2]}
  done
  printf "%-${name}s  %-${group}s  %5s  %-12s  %s\n" NAME GROUP PORT STATE DETAIL
  for row in $rows; do
    local -a f=("${(@ps:\t:)row}")
    printf "%-${name}s  %-${group}s  %5s  %-12s  %s\n" "$f[1]" "$f[2]" "$f[3]" "$f[4]" "$f[5]"
  done
}

encode() {
  osascript -l JavaScript -e 'function run(argv) { return encodeURIComponent(argv[0]) }' "$1"
}

# Checks a name or group against status.json before sending, so a typo says so.
# Skipped when there is no status.json yet (Portkeep never ran this version).
require() {
  local kind=$1 value=$2 found
  found=$(read_status "$kind" "$value") || return 0
  [[ $found == missing ]] && return 0
  if [[ -z $found ]]; then
    if [[ $kind == names ]]; then print -u2 "$me: no tunnel named \"$value\". Try: $me list"
    else print -u2 "$me: no group named \"$value\". Try: $me list"; fi
    return 1
  fi
}

send() {
  open -g "portkeep://$1"
}

need_arg() {
  if [[ -z ${2:-} ]]; then
    print -u2 "$me: $1 needs a $3."
    usage >&2
    exit 64
  fi
}

cmd=${1:-help}
arg=${2:-}

case $cmd in
  list|ls)
    out=$(read_status list)
    if [[ $out == missing ]]; then print -u2 "$me: no status yet; open Portkeep first."; exit 1; fi
    if [[ -z $out ]]; then print "No tunnels yet."; exit 0; fi
    print_table "$out"
    ;;
  status)
    if [[ -z $arg ]]; then exec "$0" list; fi
    out=$(read_status status "$arg")
    if [[ $out == missing ]]; then print -u2 "$me: no status yet; open Portkeep first."; exit 1; fi
    if [[ -z $out ]]; then print -u2 "$me: no tunnel named \"$arg\"."; exit 1; fi
    print_table "$out"
    # For scripts: 0 when connected, 1 when not, 2 when only some of several with this name are.
    [[ $out != *$'\t'connected$'\t'* ]] && exit 1
    for row in "${(@f)out}"; do [[ $row == *$'\t'connected$'\t'* ]] || exit 2; done
    exit 0
    ;;
  start|stop|toggle)
    need_arg $cmd "$arg" "tunnel name"
    require names "$arg" || exit 1
    send "$cmd?name=$(encode "$arg")"
    ;;
  start-group|stop-group)
    need_arg $cmd "$arg" "group name"
    require groups "$arg" || exit 1
    send "${cmd%-group}?group=$(encode "$arg")"
    ;;
  start-all|stop-all)
    send "${cmd%-all}?all"
    ;;
  open)
    if [[ -n $arg ]]; then
      require names "$arg" || exit 1
      open "portkeep://open?name=$(encode "$arg")"
    else
      open "portkeep://open"
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    print -u2 "$me: unknown command \"$cmd\"."
    usage >&2
    exit 64
    ;;
esac
